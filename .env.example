# Everything here can also be set from the Settings page (stored in data/settings.json).
# Values in data/settings.json win over these env defaults.

# Where Agentic OS keeps its JSON stores, generated sites and media (default: ./data)
# AGENTIC_OS_DATA=./data

# Your Obsidian vault — used as shared memory for every agent (default: ./data/vault)
# OBSIDIAN_VAULT=/Users/you/Documents/Obsidian/Brain

# Netlify personal access token (User settings → Applications → Personal access tokens)
# NETLIFY_AUTH_TOKEN=

# Any OpenAI-compatible API (OpenRouter, DeepSeek, xAI, OpenAI…) used as a fallback engine
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=openrouter/auto

# OMI developer key (omi_dev_…) for the daily memory import (also settable in Settings → OMI)
# OMI_API_KEY=

# Google service-account key JSON (one line) for Search Console clicks on SEO → History
# GSC_SERVICE_ACCOUNT_JSON=

# Background scheduler for automations and OMI auto-import (default on)
# AGENTIC_OS_SCHEDULER=off

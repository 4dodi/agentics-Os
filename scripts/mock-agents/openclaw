#!/usr/bin/env node
// Stand-in for the Hermes CLI so Agentic OS can be tried (and tested) without installing Hermes.
// Usage mirrors the default template: `hermes --version`, `hermes chat -q "<prompt>"`.
const fs = require("node:fs");
const path = require("node:path");
const args = process.argv.slice(2);
const name = path.basename(process.argv[1]);
if (args[0] === "--version") {
  console.log(`${name === "openclaw" ? "OpenClaw 2026.10 (mock)" : "Hermes Agent v0.9.0 (mock)"}`);
  process.exit(0);
}
const qi = args.findIndex((a) => a === "-q" || a === "--message");
let prompt = qi >= 0 ? args[qi + 1] : "";
if (!prompt && !process.stdin.isTTY) prompt = fs.readFileSync(0, "utf8");
if (!prompt) {
  console.log(`${name} (mock): ${args.join(" ") || "no command"}`);
  process.exit(0);
}

// Media requests: write a tiny real PNG into the folder the prompt names and reply with its path.
const folder = prompt.match(/Save the final file into this folder: (.+)/)?.[1]?.trim();
if (folder && /image generation/.test(prompt)) {
  const png = Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAFklEQVR4nGNgYGD4z8DAwMDAwMDAAAANAAH4oL2UAAAAAElFTkSuQmCC", "base64");
  fs.mkdirSync(folder, { recursive: true });
  const file = path.join(folder, `mock_${Date.now()}.png`);
  fs.writeFileSync(file, png);
  console.log(`Done! Saved the image to:\n${file}`);
  process.exit(0);
}

// SEO article requests: emit front matter + markdown.
const kw = prompt.match(/targeting the keyword "([^"]+)"/)?.[1];
const site = prompt.match(/Site: (.+)/)?.[1] ?? "";
let out;
if (kw) {
  const angle = prompt.match(/Editorial angle for this site: (.+)/)?.[1] ?? "guide";
  out = `---\ntitle: ${kw}: ${angle}\ndescription: A ${angle.toLowerCase()} on ${kw}, written from first-hand experience for readers of ${site}.\n---\n# ${kw} — ${angle}\n\nShort answer first: ${kw} is worth it if you want an agent that runs locally and learns from your notes.\n\n## Why it matters\n\nThis mock article was generated by the mock ${name} CLI for **${site}**. ${"Lorem ipsum dolor sit amet. ".repeat(12)}\n\n## How to get started\n\n1. Install it\n2. Give it context\n3. Automate one thing per week\n\n## FAQ\n\n**Is it free?** Mostly.\n\n## Conclusion\n\nStart small and build up.`;
} else {
  out = `**${name} (mock)** received ${prompt.length} chars.\n\nLast line: ${prompt.trim().split("\n").pop().slice(0, 200)}`;
}
// Stream it out in chunks like a real agent would.
const chunks = out.match(/[\s\S]{1,40}/g);
let i = 0;
const t = setInterval(() => {
  if (i >= chunks.length) {
    clearInterval(t);
    process.stdout.write("\n");
    return;
  }
  process.stdout.write(chunks[i++]);
}, 15);
